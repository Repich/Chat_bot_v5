WIICON5_LLM_API_BASE=https://api.example.com/v1
WIICON5_LLM_API_KEY=change-me
WIICON5_LLM_MODEL=deepseek-chat
WIICON5_LLM_TIMEOUT_SECONDS=60

WIICON5_MCP_URL=http://127.0.0.1:6003
WIICON5_MCP_TIMEOUT_SECONDS=30
WIICON5_CONFIG_FINGERPRINT=local

# Automatic learned skills. Default experiment mode: bot-local, active immediately,
# but auto-blocked after repeated runtime failures.
WIICON5_AUTO_LEARNED_SKILLS_ENABLED=true
WIICON5_AUTO_LEARNED_SKILLS_ACTIVATE=true
WIICON5_AUTO_LEARNED_SKILLS_SCOPE=bot
WIICON5_AUTO_LEARNED_SKILLS_FAILURE_THRESHOLD=3

# Admin API protection for /api/admin/*
WIICON5_ADMIN_ENABLED=true
WIICON5_ADMIN_BIND_LOCAL_ONLY=true
# WIICON5_ADMIN_TOKEN=change-me
# WIICON5_ADMIN_ALLOWED_CONFIG_ROOTS=/path/to/config/root
WIICON5_WORKBENCH_ALLOW_RAW_QUERY_EDIT=false

# Optional overrides
# WIICON5_SKILLS_DIR=/path/to/WiiconChatBot5/skills
# WIICON5_BINDINGS_DIR=/path/to/WiiconChatBot5/skills/bindings
# WIICON5_RUNS_DIR=/path/to/WiiconChatBot5/runs
