# Fill these values before the first production start.
WIICON5_LLM_API_BASE=http://internal-llm-gateway/v1
WIICON5_LLM_API_KEY=
WIICON5_LLM_MODEL=gpt-5.4
WIICON5_LLM_TIMEOUT_SECONDS=120
# Use external for ChatGPT/OpenAI-compatible API. Confidential runtime data remains blocked
# unless the explicit opt-in below is enabled.
WIICON5_LLM_TRUST_ZONE=external
# Required only for trust_zone=internal; exact hostname from WIICON5_LLM_API_BASE.
WIICON5_INTERNAL_LLM_ALLOWED_HOSTS=
# WARNING: true permits user messages, 1C data, metadata and documentation to be sent externally.
WIICON5_ALLOW_EXTERNAL_CONFIDENTIAL_LLM=false

WIICON5_MCP_URL=http://127.0.0.1:6003
WIICON5_MCP_TIMEOUT_SECONDS=60

# The web service listens on every network interface on TCP 7786.
# User-facing URL: http://ms-1cmonitor:7786/

# The installer generates a random administrative token automatically.
WIICON5_ADMIN_ENABLED=true
WIICON5_ADMIN_BIND_LOCAL_ONLY=false
WIICON5_ADMIN_TOKEN=
WIICON5_ADMIN_ALLOWED_CONFIG_ROOTS=C:\Monitoring\WiiconChatBot_5\data

# Optional second model used to recover from a failed 1C query.
WIICON5_FAILURE_SOLVER_ENABLED=false
WIICON5_FAILURE_SOLVER_PROVIDER=openai_compatible
WIICON5_FAILURE_SOLVER_API_BASE=
WIICON5_FAILURE_SOLVER_API_KEY=
WIICON5_FAILURE_SOLVER_MODEL=gpt-5.4
WIICON5_FAILURE_SOLVER_TIMEOUT_SECONDS=120
WIICON5_FAILURE_SOLVER_TRUST_ZONE=external
WIICON5_FAILURE_SOLVER_INTERNAL_ALLOWED_HOSTS=
